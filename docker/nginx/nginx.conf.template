# nginx.conf.template — rendered via sed at container boot.
# Env vars: ${GOOGLE_API_KEY} ${GOOGLE_API_HOST} ${SERVER_PORT} ${NGINX_RESOLVERS}

# Per-IP rate limit on /api/* — quota protection + cheap DDoS resistance.
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=10r/s;
limit_req_status 429;

# Runtime DNS resolution for upstream. Variable in proxy_pass forces resolve
# at request time (via this `resolver`) instead of at config-parse time —
# survives DNS hiccups without crashing on boot.
resolver ${NGINX_RESOLVERS} valid=60s ipv6=off;
resolver_timeout 5s;

server {
    listen ${SERVER_PORT} default_server;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Security headers --------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    # CSP: allow self + YouTube IFrame API script + YouTube embed origins.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://yt3.ggpht.com https://yt3.googleusercontent.com; font-src 'self' data:; media-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none';" always;

    # ---- Compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/javascript application/json application/xml application/rss+xml
        image/svg+xml font/ttf font/otf;

    client_max_body_size 128k;

    # ---- /api/*  ->  https://${GOOGLE_API_HOST}/youtube/v3/*  --------------
    # Regex location captures path. We inject `key=…` as a query parameter
    # via `args` because Google's API authenticates via query string, not
    # a header.
    location ~ ^/api/(?<proxy_path>.*)$ {
        limit_req zone=api_zone burst=20 nodelay;

        # $upstream_host as variable forces runtime DNS resolution.
        set $upstream_host "${GOOGLE_API_HOST}";

        # Append `key=…` to the upstream args. If the request already has
        # query params we use `&` separator, otherwise `?`. Nginx exposes
        # this via $is_args.
        set $upstream_args "${args}";
        if ($is_args = "") {
            set $upstream_args "key=${GOOGLE_API_KEY}";
        }
        if ($is_args = "?") {
            set $upstream_args "${args}&key=${GOOGLE_API_KEY}";
        }
        proxy_pass https://$upstream_host/youtube/v3/$proxy_path?$upstream_args;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # Minimal headers. Google doesn't require auth headers — the key is
        # in the URL. We strip the browser-side stuff for safety.
        proxy_set_header Host $upstream_host;
        proxy_set_header Accept "application/json";
        proxy_set_header User-Agent "sectube/3.0";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Don't pass Set-Cookie back to the browser.
        proxy_hide_header Set-Cookie;
    }

    # ---- Healthcheck -------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Long-cache hashed assets -----------------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # ---- SPA fallback ------------------------------------------------------
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # ---- Hide dotfiles -----------------------------------------------------
    location ~ /\. { deny all; }
}
