# nginx.conf.template — rendered via sed at container boot.
# Env vars available: ${RAPIDAPI_KEY} ${RAPIDAPI_HOST} ${SERVER_PORT} ${NGINX_RESOLVERS}

# Per-IP rate limit on /api/* — quota protection + cheap DDoS resistance.
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=10r/s;
limit_req_status 429;

# Runtime DNS resolution for upstream. Using a variable in proxy_pass forces
# nginx to resolve at request time (via this `resolver`) instead of at
# config-parse time — survives DNS hiccups without crashing on boot.
resolver ${NGINX_RESOLVERS} valid=60s ipv6=off;
resolver_timeout 5s;

server {
    listen ${SERVER_PORT} default_server;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Security headers --------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    # CSP: allow self, MUI inline styles, YouTube iframe embeds, YouTube CDN images.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com https://yt3.ggpht.com https://yt3.googleusercontent.com; font-src 'self' data:; media-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none';" always;

    # ---- Compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/javascript application/json application/xml application/rss+xml
        image/svg+xml font/ttf font/otf;

    client_max_body_size 128k;

    # ---- /api/*  ->  https://${RAPIDAPI_HOST}/*  ---------------------------
    # Regex location captures path so we don't need rewrite ... break (which
    # would stop `set` from running and leave $upstream_host empty).
    location ~ ^/api/(?<proxy_path>.*)$ {
        limit_req zone=api_zone burst=20 nodelay;

        # $upstream_host as variable forces runtime DNS resolution.
        set $upstream_host "${RAPIDAPI_HOST}";
        proxy_pass https://$upstream_host/$proxy_path$is_args$args;
        proxy_ssl_server_name on;
        proxy_ssl_name $upstream_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # Key injection. Browser never sees it.
        proxy_set_header Host $upstream_host;
        proxy_set_header X-RapidAPI-Key "${RAPIDAPI_KEY}";
        proxy_set_header X-RapidAPI-Host $upstream_host;
        proxy_set_header Accept "application/json";
        proxy_set_header User-Agent "sectube/2.0";

        # Strip browser-side auth so we don't leak it upstream.
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Hide upstream-specific headers from the browser.
        proxy_hide_header X-RapidAPI-Region;
        proxy_hide_header X-RapidAPI-Version;
        proxy_hide_header Set-Cookie;
    }

    # ---- Healthcheck -------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Long-cache hashed assets -----------------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # ---- SPA fallback ------------------------------------------------------
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # ---- Hide dotfiles -----------------------------------------------------
    location ~ /\. { deny all; }
}
