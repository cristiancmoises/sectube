# nginx.conf.template — rendered via sed at container boot.
# Env vars substituted here: ${GOOGLE_API_HOST} ${SERVER_PORT} ${NGINX_RESOLVERS}
#
# NOTE: the API key(s) are NO LONGER substituted into this file. They are read
# from the environment directly by the Lua rotator (docker/nginx/lua/rotator.lua)
# so secrets never touch the rendered config on disk. See nginx.sectube.conf.

# Per-IP rate limit on /api/* — quota protection + cheap DDoS resistance.
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=10r/s;
limit_req_status 429;

# Upstream to Google, resolved ONCE at boot via the system resolver (libc /
# /etc/resolv.conf). We deliberately do NOT use a runtime `resolver` + variable
# proxy_pass here: on locked-down networks (Tor/VPN) nginx's own resolver to a
# public DNS often times out per-request, while libc name resolution at boot
# works fine. Keepalive reuses the TLS connection across requests.
upstream yt_api_upstream {
    server ${GOOGLE_API_HOST}:443 max_fails=0;
    keepalive 16;
}

# Kept for completeness; not used by the upstream above.
resolver ${NGINX_RESOLVERS} valid=300s ipv6=off;
resolver_timeout 10s;

server {
    listen ${SERVER_PORT} default_server;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Security headers --------------------------------------------------
    # Re-included in any location with its own add_header (see the snippet).
    include /etc/nginx/security-headers.conf;

    # ---- Compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/javascript application/json application/xml application/rss+xml
        image/svg+xml font/ttf font/otf;

    client_max_body_size 128k;

    # ---- /api/*  ->  rotator (Lua) -> https://${GOOGLE_API_HOST}/youtube/v3/*
    # The Lua handler picks a healthy key, makes an internal subrequest to
    # /__yt/<path> (below), retries on quota/rate/bad-key by rotating keys, and
    # serves a short-TTL shared cache for identical requests.
    location ~ ^/api/(?<proxy_path>.*)$ {
        limit_req zone=api_zone burst=20 nodelay;
        default_type application/json;
        content_by_lua_block {
            require("rotator").handle()
        }
    }

    # ---- Internal upstream: the real call to Google. ----------------------
    # `internal` => unreachable from the network; only ngx.location.capture()
    # from the rotator can hit it. The rotator appends key=… to $args.
    location ~ ^/__yt/(?<yt_path>.*)$ {
        internal;

        # Use the boot-resolved upstream group (no per-request DNS). Literal SNI
        # + Host keep TLS verification and routing correct.
        proxy_pass https://yt_api_upstream/youtube/v3/$yt_path$is_args$args;

        proxy_ssl_server_name on;
        proxy_ssl_name ${GOOGLE_API_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        # Minimal headers. Google authenticates via the key in the URL.
        proxy_set_header Host ${GOOGLE_API_HOST};
        proxy_set_header Accept "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "sectube/4.0";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        # Referer for API keys restricted to an HTTP referrer. Empty by default
        # (works with unrestricted/IP-restricted keys). Set GOOGLE_API_REFERER to
        # the key's allowed referrer (e.g. http://localhost:8090) otherwise.
        proxy_set_header Referer "${GOOGLE_API_REFERER}";

        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Don't pass Set-Cookie back through the rotator.
        proxy_hide_header Set-Cookie;
    }

    # ---- Healthcheck -------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Long-cache hashed assets -----------------------------------------
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/security-headers.conf;  # re-emit; add_header above reset inheritance
        access_log off;
        try_files $uri =404;
    }

    # ---- SPA fallback ------------------------------------------------------
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;  # re-emit; add_header above reset inheritance
        try_files $uri $uri/ /index.html;
    }

    # ---- Hide dotfiles -----------------------------------------------------
    location ~ /\. { deny all; }
}
