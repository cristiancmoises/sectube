# ---------------------------------------------------------------------------
# SecTube runtime configuration.
# Copy to `.env` before `docker compose up -d`.
# `.env` is gitignored — never commit credentials.
# ---------------------------------------------------------------------------

# Your RapidAPI key for the YouTube v3 endpoint.
# Get one at: https://rapidapi.com/ytdlfree/api/youtube-v31
# If left empty, the UI still renders but /api calls show the
# "admin must set key" error panel — no secret is ever leaked.
RAPIDAPI_KEY=

# RapidAPI provider hostname. Change only if you switch providers.
RAPIDAPI_HOST=youtube-v31.p.rapidapi.com

# Host port published on this machine. http://localhost:<PORT>
HOST_PORT=8080

# ---------------------------------------------------------------------------
# DNS (optional)
# Defaults work on normal networks. Only override if your network blocks
# public resolvers (e.g. strict-killswitch VPNs like Mullvad).
# ---------------------------------------------------------------------------
# DOCKER_DNS=1.1.1.1
# NGINX_RESOLVERS=1.1.1.1 8.8.8.8 9.9.9.9
