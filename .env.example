# ---------------------------------------------------------------------------
# SecTube runtime configuration.
# Copy to `.env` before `docker compose up -d`.
# `.env` is gitignored — never commit credentials.
# ---------------------------------------------------------------------------

# Your Google YouTube Data API v3 key(s).
#
# SecTube ROTATES across as many keys as you give it. Each key has its own
# 10,000 units/day free quota (~100 searches), so N keys ≈ N× the daily budget.
# When a key hits quotaExceeded / a rate limit / turns out invalid, the rotator
# takes it out for a cooldown and serves the next healthy key automatically —
# the site keeps working until EVERY key is dry.
#
# Paste as many as you like, comma-separated (whitespace/newlines also work):
GOOGLE_API_KEYS=
# Example:
# GOOGLE_API_KEYS=AIzaSyAAA...,AIzaSyBBB...,AIzaSyCCC...,AIzaSyDDD...
#
# How to get a key (free, no credit card, ~5 minutes each):
#   1. Go to https://console.cloud.google.com
#   2. Create a new project (or pick an existing one)
#   3. Top search bar: "YouTube Data API v3" -> Enable
#   4. Sidebar -> APIs & Services -> Credentials -> Create Credentials -> API key
#   5. Paste the key into GOOGLE_API_KEYS above
#   6. (Recommended) Restrict the key to "YouTube Data API v3" only.
# TIP: create several projects (each gets its own quota) and list every key here.

# Single-key back-compat. If you only have one key you can set it here instead;
# it is merged in with GOOGLE_API_KEYS (deduped).
GOOGLE_API_KEY=

# YouTube Data API endpoint. Don't change unless Google moves it.
GOOGLE_API_HOST=youtube.googleapis.com

# HTTP-referrer-restricted keys — a top cause of "API access denied".
# If your key's Application restriction is "HTTP referrers (websites)", this
# server-side proxy MUST send a matching referrer or Google blocks every request.
# Set it to your site URL (must match one of the key's allowed referrers):
#   custom domain:  GOOGLE_API_REFERER=https://tube.example.com
#   local testing:  GOOGLE_API_REFERER=http://localhost:8090
# Leave empty/commented for unrestricted or IP-restricted keys — which is the
# RECOMMENDED setup for server-side use (Console → key → Application
# restrictions → None, or restrict by IP).
# GOOGLE_API_REFERER=

# Host port published on this machine. http://localhost:<PORT>
HOST_PORT=8080

# ---------------------------------------------------------------------------
# Rotation + cache tuning (optional — sane defaults shown).
# ---------------------------------------------------------------------------
# Seconds a key sits out after quotaExceeded/dailyLimitExceeded (default 1800).
# Quota resets at midnight Pacific; the key is re-probed every cooldown.
# GOOGLE_KEY_QUOTA_COOLDOWN=1800
# Seconds a key sits out after a short rate-limit (default 30).
# GOOGLE_KEY_RATE_COOLDOWN=30
# Seconds an invalid/referrer-blocked key sits out before re-probe (default 3600).
# GOOGLE_KEY_BAD_COOLDOWN=3600
# Seconds an identical upstream response is reused from the shared cache so many
# users browsing the same feed cost ONE quota hit (default 300). 0 disables.
# GOOGLE_API_CACHE_TTL=300

# ---------------------------------------------------------------------------
# DNS (optional)
# Defaults work on normal networks. Override only if your network blocks
# public resolvers (strict-killswitch VPNs like Mullvad).
# ---------------------------------------------------------------------------
# DOCKER_DNS=1.1.1.1
# NGINX_RESOLVERS=1.1.1.1 8.8.8.8 9.9.9.9
