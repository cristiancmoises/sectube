# syntax=docker/dockerfile:1.7
# =========================================================================
# Stage 1: build the React bundle.
# =========================================================================
# node:22-slim (Debian) rather than -alpine:
#  - glibc handles native binaries (rolldown, esbuild) more predictably than musl
#  - fewer npm "Exit handler never called!" crashes under memory pressure
# The builder stage is discarded, so the extra ~150MB never ships.
FROM node:22-slim AS builder

WORKDIR /app

# Better npm defaults: shorter fetch timeouts, fewer retries, quieter output.
ENV NPM_CONFIG_FETCH_TIMEOUT=60000 \
    NPM_CONFIG_FETCH_RETRIES=2 \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_PROGRESS=false

# Install deps first for cache efficiency. `npm ci` requires package-lock.json
# to be in sync — keeps supply chain reproducible.
COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then \
      npm ci --prefer-offline --no-audit --no-fund --no-progress; \
    else \
      npm install --prefer-offline --no-audit --no-fund --no-progress; \
    fi

COPY . .

# Give Vite/rolldown a 4GB heap. Required on constrained Docker hosts.
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

# =========================================================================
# Stage 2: serve static files via nginx (unprivileged image, rootless).
# =========================================================================
# nginxinc/nginx-unprivileged runs as UID 101 by default and listens on a
# non-privileged port out of the box. No USER root anywhere.
#
# We deliberately do NOT `apk add` anything — the base image already has
# everything we need (nginx, ca-certificates, BusyBox's sed/wget), so the
# image build has zero network dependencies beyond the base pull itself.
FROM nginxinc/nginx-unprivileged:1.31-alpine AS runner

USER root

# Remove the default config so our template-rendered one is authoritative.
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy template + entrypoint.
COPY docker/nginx/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker/entrypoint.sh /docker-entrypoint-sectube.sh
RUN chmod +x /docker-entrypoint-sectube.sh

# Copy the built site.
COPY --from=builder /app/dist /usr/share/nginx/html

# Permissions: nginx user must be able to read html AND write conf.d at boot.
RUN chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/conf.d /etc/nginx/templates

USER nginx

EXPOSE 8080

# Healthcheck — wget is in BusyBox, always present. No curl needed.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/bin/sh", "/docker-entrypoint-sectube.sh"]
