# Build context for BOTH images:
#   - Dockerfile.full-build (default) compiles React inside Docker → needs the
#     SOURCE (package.json, src/, public/, index.html, vite.config.js, docker/).
#   - Dockerfile (lean) → needs the prebuilt dist/.
# So we exclude only what must NEVER be in a build context: secrets, the giant
# host-specific node_modules, and VCS/editor junk.
node_modules
.git
.gitignore
.dockerignore

# Secrets — never ship keys into an image. Keep the example.
.env
.env.*
!.env.example

# Heavy / irrelevant
.vite
coverage
.vscode
.idea
.DS_Store
npm-debug.log*
*.log
